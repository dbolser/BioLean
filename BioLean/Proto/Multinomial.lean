theorem R01a_plain_B1_1957 : fr_R01a.verdictsB1 1957 = [.unsupported, .unsupported, .unsupported, .unsupported] := by decide +kernel
theorem R01a_plain_B3_1957 : fr_R01a.verdictsB3 1957 = [.unsupported, .unsupported, .unsupported, .unsupported] := by decide +kernel
