    (List.range 3).flatMap fun si => (List.range 3).flatMap fun mi => [false, true].map fun mem =>
      let rules := [[], phosphoHis, allReports].getD si []
      let m := models.getD mi EvidenceModel.standard
      (d, f, si, mi, mem, exitPass m rules ({ dual := d, face := f, dropMemory := mem : Enc }.two))

