    [("chemiosmotic", .established), ("chemical intermediate", .refuted)] := by decide +kernel
#guard cells (supRiv allReports Enc.dualEntry.two 1974) 1974 = ["b=0.803 d=0.135 established", "b=0.108 d=0.819 refuted"]
