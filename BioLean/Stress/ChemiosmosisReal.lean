/-! ## Option N: forgetting (evidence ages; prototype outside the core)

Each item's pseudo-count `r/(1-r)` halves every `h` years of age. In the core this would be a new
operator on `Statement` (an age-discounted `opinionAt`), no new type. Here it is computed outside
the core, in pseudo-counts, which is exact: cumulative fusion adds counts, and `against` of belief
`b` adds `b/(1-b)` to disbelief. With no decay it equals the core's `Rivalry.opinions` (pinned). -/

/-- Supporting and refuting pseudo-counts of a statement in `year`, each item discounted by
`1/2^(age / h)`. -/
def agedCounts [m : EvidenceModel] (h year : Nat) (s : Statement) : ℚ × ℚ :=
  (s.asOf year).distinctEvidence.foldl (fun acc e =>
    let r := m.reliability e.kind
    let c := r / (1 - r) / ((2 ^ ((year - e.year) / h) : ℕ) : ℚ)
    if e.polarity == .supports then (acc.1 + c, acc.2) else (acc.1, acc.2 + c)) (0, 0)

/-- Belief and disbelief of each rival under the rivalry, with forgetting. -/
def forget [EvidenceModel] (h year : Nat) (r : Rivalry) : List (ℚ × ℚ) :=
  let own := r.rivals.map (agedCounts h year)
  (Rivalry.others [] own).map fun (c, rest) =>
    let extra := rest.foldl (fun a t => let b := t.1 / (t.1 + t.2 + 1); a + b / (1 - b)) 0
    let n := c.1 + c.2 + extra + 1
    (c.1 / n, (c.2 + extra) / n)

/-- `Opinion.verdict` at the default thresholds, on a belief and disbelief pair. -/
def verdictOf (b d : ℚ) : Verdict :=
  if 1 / 4 ≤ b ∧ 1 / 4 ≤ d then .contested else if 4 / 5 ≤ b then .established
  else if 4 / 5 ≤ d then .refuted else .unsupported

def forgetYears [EvidenceModel] (h : Nat) (r : Rivalry) (i : Nat) (v : Verdict) : List Nat :=
  allYears.filter fun y => ((forget h y r)[i]?.map fun p => verdictOf p.1 p.2) == some v

-- With h = 1000 nothing is forgotten, and the prototype gives exactly the core's numbers.
#guard [1965, 1974, 2020].all fun y => [Enc.single.two, Enc.dualEntry.two].all fun r =>
  forget 1000 y r == ((r.opinionsAt y).map fun p => (p.2.belief, p.2.disbelief))

