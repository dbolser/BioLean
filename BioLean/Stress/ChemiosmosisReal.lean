/-- One publication, with what the encodings need to know about it. `ev.kind` is the kind as
published (experiment `.inVitro`, review `.review`, proposal `.hypothesis`); the encoding decides
how a review counts. `dual`: a discriminating experiment that dual entry also puts on S as a
refutation. `memory`: its direction was taken from memory and is UNVERIFIED. -/
structure Item where
  key : String
  side : Side
  lab : String
  review : Bool
  advocate : Bool
  dual : Bool
  memory : Bool
  ev : Evidence

