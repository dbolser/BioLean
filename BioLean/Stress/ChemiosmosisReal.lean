def photoETC : Entity .process := ⟨"GO:0009767", "photosynthetic electron transport chain"⟩
def photophos : Entity .process := ⟨"GO:0009777", "photosynthetic phosphorylation"⟩
def thylakoidMembrane : Entity .component := ⟨"GO:0009535", "chloroplast thylakoid membrane"⟩
def kcl : Entity .chemical := ⟨"CHEBI:32588", "potassium chloride"⟩
def cacl2 : Entity .chemical := ⟨"CHEBI:3312", "calcium dichloride"⟩

def inKCl : Entity .process := photoETC.inCtx { condition := some (.environment kcl) }
def inKClCa : Entity .process := inKCl.refine Rel.surroundedBy cacl2

def chiangBulk : Statement where
  id := "Chiang 1989, 100 mM KCl: delocalised"
  text := "in 100 mM KCl, photosynthetic electron transport drives photophosphorylation through bulk protons"
  claim := .mediatedBy inKCl .pos (.process photophos) (.amount hydron)
  evidence := [w15.ev]

def chiangLocal : Statement where
  id := "Chiang 1989, KCl plus 5 mM CaCl2: localised"
  text := "with CaCl2 added, it does so through protons held in the thylakoid membrane"
  claim := .mediatedBy inKClCa .pos (.process photophos)
