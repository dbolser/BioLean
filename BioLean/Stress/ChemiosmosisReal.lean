/-- The M2 exit test: 1965 chemiosmosis contested; 1974 chemiosmosis established and S refuted. -/
def exitPass (m : EvidenceModel) (rules : List (Nat × Nat)) (r : Rivalry) : Bool :=
  (@vs m (supRiv rules r 1965)).head? == some .contested &&
    @vs m (supRiv rules r 1974) == [.established, .refuted]

