/-! ## Option G (crude): one lab, one vote (as an operator, a core change; as an import merge, data) -/

def labOf (p : Nat) : String := ((record.find? (·.ev.pmid == p)).map (·.lab)).getD ""

def insertByYear (e : Evidence) : List Evidence → List Evidence
  | [] => [e]
  | x :: xs => if e.year < x.year then e :: x :: xs else x :: insertByYear e xs

/-- The earliest item per lab, polarity and hypothesis flag; ties keep list order. -/
def labVote (s : Statement) : Statement :=
  let sorted := s.evidence.foldl (fun acc e => insertByYear e acc) []
  let key (e : Evidence) := (labOf e.pmid, e.polarity == .supports, e.kind == .hypothesis)
  { s with evidence := sorted.foldl (fun acc e => if acc.any (key · == key e) then acc else acc ++ [e]) [] }

def labRivalry (enc : Enc) : Rivalry := ⟨enc.two.rivals.map labVote, by simp [Enc.two]⟩

