#guard sharedPmids Enc.dualEntry.two = [5870319, 5220864, 5970114, 16742541, 4272126, 237916, 992038]
#guard sameClaim selfRival = [("chemiosmotic", "chemiosmotic again")]
#guard sameClaim Enc.single.four = []
#guard refinesRival Enc.single.three = [("localised", "chemiosmotic")]
#guard refinesRival Enc.single.two = []
#guard refinesRival child = []
#guard refinesRival (withM Enc.single) = [("localised", "chemiosmotic")]

