/-! ## Encodings: choices a curator makes, all outside the core -/

/-- `dual`: discriminating experiments also go on S as refutations (the example's convention).
`face`: every review counts as `.review` (3/5), the advocates' own too; otherwise an advocate's
review is a `.hypothesis` (weight 0), as the example treats `reviews63`. `dropMemory`: leave out
the items whose direction is from memory. `drop`: PMIDs left out; `dropKeys`: record keys left
out (for the one item with no PMID). `splitSides`: S's
experiments are relabelled `.observational`, so that one `EvidenceModel` can weigh the two sides
apart (CH-27; a hack the core offers no other way to do). -/
structure Enc where
  dual : Bool := false
  face : Bool := false
  dropMemory : Bool := false
  drop : List Nat := []
  dropKeys : List String := []
  splitSides : Bool := false

namespace Enc

def kind (enc : Enc) (i : Item) : EvidenceKind :=
  if i.review then (if enc.face || !i.advocate then .review else .hypothesis) else i.ev.kind

def keep (enc : Enc) (i : Item) : Bool :=
  !(enc.drop.contains i.ev.pmid) && !(enc.dropKeys.contains i.key) && !(enc.dropMemory && i.memory)

def relabel (enc : Enc) (s : Side) (e : Evidence) : Evidence :=
  if enc.splitSides && s == .S && e.kind == .inVitro then { e with kind := .observational } else e

/-- The evidence an encoding puts on one rival. -/
def items (enc : Enc) (s : Side) : List Evidence :=
  (record.filter enc.keep).filterMap fun i =>
    if i.side == s then some (enc.relabel s { i.ev with kind := enc.kind i })
    else if enc.dual && i.dual && s == .S then
      some (enc.relabel s { i.ev with kind := enc.kind i, polarity := .refutes })
    else none

def name : Side → String
  | .C => "chemiosmotic" | .S => "chemical intermediate" | .W => "localised"
  | .G => "conformational" | .M => "murburn" | .none => "none"

/-- Same agent, same target, different mediator, as in the example. W's mediator is the hydron
refined to the inner membrane: by the refinement axiom it is_a hydron. -/
def mediator : Side → Target
  | .C => .amount hydron
  | .S => .amount cI
  | .W => .amount (hydron.inCtx { component := some innerMembrane })
  | .G => .amount conf
  | .M => .amount ros
  | .none => .amount cI

def stmt (enc : Enc) (s : Side) : Statement where
  id := name s
  text := name s
  claim := .mediatedBy respChain .pos (.process oxphos) (mediator s)
  evidence := enc.items s

def two (enc : Enc) : Rivalry := ⟨[enc.stmt .C, enc.stmt .S], by simp⟩
def three (enc : Enc) : Rivalry := ⟨[enc.stmt .C, enc.stmt .S, enc.stmt .W], by simp⟩
def four (enc : Enc) : Rivalry := ⟨[enc.stmt .C, enc.stmt .S, enc.stmt .W, enc.stmt .G], by simp⟩

/-- Each item on the one rival it bears on, as the `Rivalry` docstring asks. -/
def single : Enc := {}
/-- The example's convention: discriminating experiments on both rivals. -/
def dualEntry : Enc := { dual := true }
/-- Reviews at face value. -/
def faceValue : Enc := { face := true }

end Enc

/-! ## Reading verdicts -/

/-- The verdicts of a rivalry, in rival order. -/
def vs [EvidenceModel] (r : Rivalry) : List Verdict := r.opinions.map (·.2.verdict)

/-- The verdicts in `year`. -/
def vAt [EvidenceModel] (r : Rivalry) (year : Nat) : List Verdict := vs (r.asOf year)

/-- 1950 to 2025. -/
def allYears : List Nat := List.range' 1950 76

/-- The years from 1950 to 2025 in which rival `i` has verdict `v`. -/
def yearsWhere [EvidenceModel] (r : Rivalry) (i : Nat) (v : Verdict)
    (ys : List Nat := allYears) : List Nat :=
  ys.filter fun y => (vAt r y)[i]? == some v

def verdictName : Verdict → String
  | .established => "established" | .contested => "contested"
  | .refuted => "refuted" | .unsupported => "unsupported"

def cell (o : Opinion) : String :=
  s!"b={o.belief.toDecimal} d={o.disbelief.toDecimal} {verdictName o.verdict}"

/-- Each rival's opinion in `year`, printed. -/
def cells [EvidenceModel] (r : Rivalry) (year : Nat) : List String :=
  (r.opinionsAt year).map (cell ·.2)

def table [EvidenceModel] (r : Rivalry) (ys : List Nat) : String :=
  String.intercalate "\n" (ys.map fun y => s!"{y}  " ++ String.intercalate "  "
    ((r.opinionsAt y).map fun p => s!"{p.1.id}: {cell p.2}"))

/-! ## A lemma: a rivalry's verdicts only change in evidence years

`Statement.forall_opinionAt` does this for one statement. The same holds for a rivalry, which is
what "never established, in any year" needs. Not a core change: it is about `Rivalry.asOf` as it
is, and could move to `Rivalry.lean`. -/

/-- The rivalry as of `a` and as of `b` agree when no evidence year separates them. -/
theorem Rivalry.asOf_congr (r : Rivalry) {a b : Nat}
    (h : ∀ s ∈ r.rivals, ∀ e ∈ s.evidence, (e.year ≤ a ↔ e.year ≤ b)) : r.asOf a = r.asOf b := by
  obtain ⟨rs, h2⟩ := r
  simp only [Rivalry.asOf, Rivalry.mk.injEq]
  apply List.map_congr_left
  intro s hs
  simp only [Statement.asOf, Statement.mk.injEq, true_and]
  apply List.filter_congr
  intro e he
  simp [h s hs e he]

/-- A property of the rivalry holds in every year from `lo` on once it holds in `lo` and in each
listed year from `lo` on, provided the list holds every evidence year. -/
theorem Rivalry.forall_from (r : Rivalry) (l : List Nat) (lo : Nat) {P : Rivalry → Prop}
    (hl : ∀ s ∈ r.rivals, ∀ e ∈ s.evidence, e.year ∈ l)
    (h0 : P (r.asOf lo)) (h : ∀ y ∈ l, lo ≤ y → P (r.asOf y)) (year : Nat) (hy : lo ≤ year) :
    P (r.asOf year) := by
  have cut : ∀ l' : List Nat, ∃ y, (y = lo ∨ (y ∈ l' ∧ lo ≤ y)) ∧ y ≤ year ∧
      ∀ a ∈ l', a ≤ year → a ≤ y := by
    intro l'
    induction l' with
    | nil => exact ⟨lo, Or.inl rfl, hy, by simp⟩
    | cons a l' ih =>
      obtain ⟨y, hy1, hle, hcov⟩ := ih
      have keep : y = lo ∨ (y ∈ a :: l' ∧ lo ≤ y) := by
        rcases hy1 with h1 | ⟨h1, h2⟩
        · exact Or.inl h1
        · exact Or.inr ⟨List.mem_cons_of_mem _ h1, h2⟩
      by_cases ha : a ≤ year
      · by_cases hay : a ≤ y
        · refine ⟨y, keep, hle, ?_⟩
          intro b hb hb'
          rcases List.mem_cons.1 hb with rfl | hb
          · exact hay
          · exact hcov b hb hb'
        · refine ⟨a, Or.inr ⟨by simp, ?_⟩, ha, ?_⟩
          · rcases hy1 with h1 | ⟨_, h2⟩ <;> omega
          · intro b hb hb'
            rcases List.mem_cons.1 hb with rfl | hb
            · exact le_rfl
            · have := hcov b hb hb'; omega
      · refine ⟨y, keep, hle, ?_⟩
        intro b hb hb'
        rcases List.mem_cons.1 hb with rfl | hb
        · exact absurd hb' ha
        · exact hcov b hb hb'
  obtain ⟨y, hy1, hle, hcov⟩ := cut l
  have same : r.asOf year = r.asOf y := by
    apply Rivalry.asOf_congr
    intro s hs e he
    have := hcov e.year (hl s hs e he)
    constructor
    · exact this
    · intro h'; omega
  rw [same]
  rcases hy1 with rfl | ⟨h1, h2⟩
  · exact h0
  · exact h y h1 h2

