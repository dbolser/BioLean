/-! ## Option I: rival scope (a change to `Rivalry.opinions`; no new type) -/

/-- I2: a rival with evidence of its own (an item that is more than a hypothesis). -/
def ownEvidence (s : Statement) : Bool := s.evidence.any (·.kind != .hypothesis)

/-- A rival that fails `inScope` receives no disbelief from the others. One with no belief already
passes none on (`against` of belief 0 is vacuous). -/
def scopedBy [EvidenceModel] (inScope : Statement → Bool) (r : Rivalry) : List (Statement × Opinion) :=
  (Rivalry.others [] r.rivals).map fun (s, rest) =>
    (s, if inScope s then rest.foldl (fun o t => o.fuse t.opinion.against) s.opinion else s.opinion)

/-- I1: in scope from the proposal year (any item, hypotheses included). -/
def scoped1At [EvidenceModel] (r : Rivalry) (year : Nat) : List Verdict :=
  (scopedBy (!·.evidence.isEmpty) (r.asOf year)).map (·.2.verdict)

/-- I2: in scope from the first item of evidence of its own. -/
def scopedAt [EvidenceModel] (r : Rivalry) (year : Nat) : List Verdict :=
  (scopedBy ownEvidence (r.asOf year)).map (·.2.verdict)

