/-! ## Option D1: a dated retirement list (data; as a field on `Evidence` it is D2, a core change)

D1 and D2 give the same numbers by construction: D2 only moves the list onto the item. -/

/-- An item stops counting from a curated year: `(pmid, year)`. -/
def supersede (rules : List (Nat × Nat)) (year : Nat) (s : Statement) : Statement :=
  { s with evidence := s.evidence.filter fun e => !(rules.any fun (p, y) => p == e.pmid && y ≤ year) }

/-- Sourced: the 1962 and 1963 phosphohistidine reports, reassigned to succinate thiokinase in 1964
(PMIDs 5871845, 5332854). -/
def phosphoHis : List (Nat × Nat) := [(14014715, 1964), (13942705, 1964)]
/-- The sourced pair, plus the CH-10 refutations retired with them (CH-11). -/
def phosphoBoth : List (Nat × Nat) := phosphoHis ++ [(5871845, 1964), (5332854, 1964)]
/-- Not sourced: also the five reports with no dated refutation, retired from 1974. This types
the answer in. -/
def allReports : List (Nat × Nat) :=
  phosphoHis ++ [(16590695, 1974), (13943645, 1974), (13901866, 1974), (5507209, 1974), (138419, 1974)]

def supRiv (rules : List (Nat × Nat)) (r : Rivalry) (year : Nat) : Rivalry :=
  ⟨(r.asOf year).rivals.map (supersede rules year), by simpa using (r.asOf year).two_le⟩

/-- CH-10. Sourced retirement only: 1974 chemiosmosis still unsupported. -/
theorem phospho_single_1974 : vs (supRiv phosphoHis Enc.single.two 1974) = [.unsupported, .contested] := by
  decide +kernel
#guard cells (supRiv phosphoHis Enc.single.two 1974) 1974 = ["b=0.728 d=0.214 unsupported", "b=0.428 d=0.493 contested"]
/-- CH-11. Retire the two 1964 refutations with what they refuted: 1974 contested. -/
