/-! ## Option L: a margin report (outside the core; reads `Opinion.verdict`'s thresholds) -/

/-- Distance from an opinion to the nearest verdict threshold. -/
def margin (o : Opinion) (θ : ℚ := 4 / 5) (τ : ℚ := 1 / 4) : ℚ :=
  [|o.belief - τ|, |o.disbelief - τ|, |o.belief - θ|, |o.disbelief - θ|].foldl min 1

/-- CH-48. The 1974 single-entry verdict on chemiosmosis sits 1/148 (0.007) from τ. -/
theorem margin_1974 : ((Enc.single.two.opinionsAt 1974).map (margin ·.2)).head? = some (1 / 148) := by
  decide +kernel

/-- Years in which chemiosmosis's verdict sits within 0.02 of a threshold. -/
def knifeEdge [EvidenceModel] (r : Rivalry) : List Nat :=
  allYears.filter fun y => ((r.opinionsAt y).head?.map (margin ·.2)).getD 1 < 1 / 50

-- CH-48. Not one knife edge but most years: single entry, 47 years within 0.02 of a threshold
-- (1978 to 2019 all at 0.010: disbelief 0.239 against τ = 0.25); dual entry, 54 years.
#guard knifeEdge Enc.single.two = [1964] ++ List.range' 1973 4 ++ List.range' 1978 42
#guard knifeEdge Enc.dualEntry.two = [1964, 1967, 1968] ++ List.range' 1975 51
#guard ((Enc.single.two.opinionsAt 1990).head?.map (fun p => (margin p.2).toDecimal)) = some "0.010"

/-! ## Option M: well-formedness lints for a rivalry (Bool, outside the core; as proof fields on
`Rivalry` they would be a core change) -/

/-- PMIDs (other than 0) that sit on two or more rivals. -/
def sharedPmids (r : Rivalry) : List Nat :=
  let ps := r.rivals.map fun s => (s.evidence.map (·.pmid)).filter (· != 0)
  let all := ps.flatten.foldl (fun acc p => if acc.contains p then acc else acc ++ [p]) []
  all.filter fun p => (ps.filter (·.contains p)).length ≥ 2

def targetCurie : Target → String
  | .activity p _ => p.curie | .amount m => m.curie | .process p => p.curie
  | .phenotype p => p.curie | .site a => a.curie

/-- A `mediatedBy` claim as agent, sign, target and mediator curies; other claims by subject. -/
def claimKey : Claim → List String
  | .mediatedBy a s t m => [a.curie, repr s |>.pretty, targetCurie t, targetCurie m]
  | c => [c.subjectCurie]

def mediatorCurie : Claim → Option String
  | .mediatedBy _ _ _ m => some (targetCurie m)
  | _ => none

/-- Pairs of rivals with the same claim. -/
def sameClaim (r : Rivalry) : List (String × String) :=
  (Rivalry.others [] r.rivals).flatMap fun (s, rest) =>
    (rest.filter fun t => claimKey t.claim == claimKey s.claim && s.id < t.id).map fun t => (s.id, t.id)

/-- Pairs `(a, b)` where rival `a`'s mediator refines rival `b`'s: by the refinement axiom `a`
implies `b`, so they cannot exclude each other. Read off the curie, as `Ctx.taxonOfCurie` does. -/
def refinesRival (r : Rivalry) : List (String × String) :=
  (Rivalry.others [] r.rivals).flatMap fun (s, rest) => rest.filterMap fun t =>
    match mediatorCurie s.claim, mediatorCurie t.claim with
    | some a, some b => if a.startsWith (b ++ "&") then some (s.id, t.id) else none
    | _, _ => none

-- CH-18, CH-20, CH-40: each flagged. The single-entry record, the J hierarchy and the example's
