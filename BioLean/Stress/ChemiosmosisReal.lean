#guard yearsWhere (labRivalry Enc.dualEntry) 0 .established = []

/-! ## Option H (crude): one multinomial pool over the rivals (a new opinion type: core change) -/

/-- A supporting item adds its pseudo-count `r/(1-r)` to its rival, a refuting item adds it to
"other"; each PMID counts once in the pool. Prior weight 1, as `ofReliability` implies. Returns
the rivals' shares, then "other". -/
def shares [m : EvidenceModel] (r : Rivalry) (year : Nat) : List ℚ :=
  let tagged := (r.rivals.zip (List.range r.rivals.length)).flatMap fun (s, i) =>
    (s.asOf year).evidence.map fun e => (i, e)
  let once := tagged.foldl (fun (acc : List (Nat × Evidence)) (i, e) =>
    if acc.any (·.2.pmid == e.pmid) then acc else acc ++ [(i, e)]) []
  let w (e : Evidence) : ℚ := m.reliability e.kind / (1 - m.reliability e.kind)
  let n := r.rivals.length
  let count (j : Nat) : ℚ := (once.filter fun (i, e) =>
    if j == n then e.polarity == .refutes else i == j && e.polarity == .supports).foldl (fun a (_, e) => a + w e) 0
  let total := (List.range (n + 1)).foldl (fun a j => a + count j) 1
  (List.range (n + 1)).map fun j => count j / total

-- Chemiosmosis never reaches a 4/5 share.
#guard ((shares Enc.single.three 1974).map (·.toDecimal)) = ["0.509", "0.294", "0.000", "0.156"]
#guard ((shares Enc.single.three 1977).map (·.toDecimal)) = ["0.564", "0.274", "0.000", "0.129"]
#guard ((shares Enc.single.three 2020).map (·.toDecimal)) = ["0.441", "0.197", "0.162", "0.174"]

/-- Jøsang's coarsening of a multinomial opinion to one rival `i`: belief its share, disbelief the
sum of every other share (other rivals and "other"). Read with the core's thresholds. -/
def coarse [EvidenceModel] (r : Rivalry) (year i : Nat) : Verdict :=
  let sh := shares r year
  let b := sh.getD i 0
  let d := sh.foldl (· + ·) 0 - b
  if 1 / 4 ≤ b ∧ 1 / 4 ≤ d then .contested else if 4 / 5 ≤ b then .established
  else if 4 / 5 ≤ d then .refuted else .unsupported

-- CH-19, CH-22 under H. The research stage predicted H would stop W and G being refuted with no
-- data. It does not: coarsened, both are refuted in 1965, 1974, 1985 and 2020.
#guard [1965, 1974, 1985, 2020].map (coarse Enc.single.four · 2) = [.refuted, .refuted, .refuted, .refuted]
#guard [1965, 1974, 1985, 2020].map (coarse Enc.single.four · 3) = [.refuted, .refuted, .refuted, .refuted]
