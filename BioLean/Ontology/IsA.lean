                    (.node ⟨20, 13⟩ "molecule" [] [⟨5, 18263⟩]
                      (.node ⟨10, 141⟩ "immaterial entity" [⟨10, 4⟩] [⟨1, 466⟩]
                        .leaf
                        .leaf)
                      .leaf))))))))))

