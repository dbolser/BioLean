  (⟨0, 5844⟩, []),  -- GO:0005844 obsolete
  (⟨0, 6378⟩, []),  -- GO:0006378 obsolete
  (⟨0, 7050⟩, [⟨0, 51726⟩]),  -- GO:0007050 alt_id
  (⟨0, 7568⟩, []),  -- GO:0007568 obsolete
